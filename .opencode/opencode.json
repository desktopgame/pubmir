{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      ".env": "deny",
      ".env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny"
    },
    "edit": {
      ".claude/settings.json": "deny",
      ".claude/settings.local.json": "deny",
      "**/.claude/settings.json": "deny",
      "**/.claude/settings.local.json": "deny"
    },
    "bash": {
      "*": "ask",
      "git status": "allow",
      "git diff *": "allow",
      "git log -n *": "allow",
      "git add *": "allow",
      "git commit *": "allow"
    },
    "webfetch": "ask"
  }
}
